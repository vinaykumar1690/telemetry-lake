      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (encoding) (rate(ingester_http_received_bytes_total[$__rate_interval]))",
          "legendFormat": "received ({{encoding}})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (wire) (rate(ingester_payload_bytes_total[$__rate_interval]))",
          "legendFormat": "payload ({{wire}})"
