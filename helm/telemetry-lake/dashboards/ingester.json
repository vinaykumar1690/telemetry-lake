      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Bytes / s",
      "description": "Received is the body as sent (gzip or not); payload is after decompression",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
